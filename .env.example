# Copiar este archivo a ".env" (sin el ".example") y completar con los valores reales
# de Supabase → Project Settings → API. El archivo ".env" no se sube al repositorio
# (ver .gitignore) - cada uno lo completa en su propia máquina.

# Cliente (celular/web) - la "anon key" está pensada para ser pública, la protege
# Row Level Security (ver supabase/migrations/0001_initial_schema.sql)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts de servidor (sync de SEPA, etc.) - esta SÍ es secreta,
# nunca va con prefijo EXPO_PUBLIC_ (eso la expondría en la app), nunca se comparte.
SUPABASE_SERVICE_ROLE_KEY=
